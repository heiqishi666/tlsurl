from typing import Awaitable

class Response:
    @property
    def status(self) -> int: ...
    @property
    def url(self) -> str: ...
    @property
    def headers(self) -> list[tuple[str, bytes]]: ...
    @property
    def body(self) -> bytes: ...

class Client:
    def __init__(self, timeout_ms: int = 30000, max_response_bytes: int = 16777216) -> None: ...
    def request(self, method: str, url: str, headers: list[tuple[str, bytes]] | None = None, body: bytes | None = None) -> Response: ...
    def request_async(self, method: str, url: str, headers: list[tuple[str, bytes]] | None = None, body: bytes | None = None) -> Awaitable[Response]: ...

class AsyncClient:
    def __init__(self, timeout_ms: int = 30000, max_response_bytes: int = 16777216) -> None: ...
    async def request(self, method: str, url: str, headers: list[tuple[str, bytes]] | None = None, body: bytes | None = None) -> Response: ...
